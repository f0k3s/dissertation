{
  "@context": {
    "ns": "https://example.org/construction-norms/ns/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "subClassOf": {"@id": "rdfs:subClassOf", "@type": "@id"},
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "definedIn": {"@id": "ns:definedIn", "@type": "@id"},
    "statedIn": {"@id": "ns:statedIn", "@type": "@id"},
    "denotes": {"@id": "ns:denotes", "@type": "@id"},
    "refersTo": {"@id": "ns:refersTo", "@type": "@id"},
    "appliesTo": {"@id": "ns:appliesTo", "@type": "@id"},
    "aboutProperty": {"@id": "ns:aboutProperty", "@type": "@id"},
    "hasValue": {"@id": "ns:hasValue"},
    "hasUnit": {"@id": "ns:hasUnit", "@type": "@id"},
    "hasOperator": {"@id": "ns:hasOperator", "@type": "@id"},
    "hasCondition": {"@id": "ns:hasCondition", "@type": "@id"},
    "hasNormativeForce": {"@id": "ns:hasNormativeForce", "@type": "@id"},
    "verifiedBy": {"@id": "ns:verifiedBy", "@type": "@id"},
    "relatedTo": {"@id": "ns:relatedTo", "@type": "@id"},
    "hasPropertyType": {"@id": "ns:hasPropertyType", "@type": "@id"},
    "hasMaterial": {"@id": "ns:hasMaterial", "@type": "@id"},
    "hasEnumeration": {"@id": "ns:hasEnumeration", "@type": "@id"},
    "specializes": {"@id": "ns:specializes", "@type": "@id"},
    "exceptionTo": {"@id": "ns:exceptionTo", "@type": "@id"},
    "conflictsWith": {"@id": "ns:conflictsWith", "@type": "@id"},
    "supersededBy": {"@id": "ns:supersededBy", "@type": "@id"},
    "fragmentType": {"@id": "ns:fragmentType", "@type": "@id"},
    "pageStart": {"@id": "ns:pageStart", "@type": "xsd:integer"},
    "pageEnd": {"@id": "ns:pageEnd", "@type": "xsd:integer"},
    "clauseNumber": "ns:clauseNumber",
    "tableNumber": "ns:tableNumber",
    "numericValue": {"@id": "ns:numericValue", "@type": "xsd:decimal"},
    "minValue": {"@id": "ns:minValue", "@type": "xsd:decimal"},
    "maxValue": {"@id": "ns:maxValue", "@type": "xsd:decimal"},
    "symbol": "ns:symbol",
    "code": "ns:code"
  },
  "@graph": [
    {"@id": "ns:DomainEntity", "@type": "rdfs:Class", "label": "Сущность предметной области"},
    {"@id": "ns:MaterialClass", "@type": "rdfs:Class", "subClassOf": "ns:DomainEntity", "label": "Класс материала"},
    {"@id": "ns:ObjectClass", "@type": "rdfs:Class", "subClassOf": "ns:DomainEntity", "label": "Класс объекта"},
    {"@id": "ns:ProcessClass", "@type": "rdfs:Class", "subClassOf": "ns:DomainEntity", "label": "Класс процесса"},
    {"@id": "ns:PropertyType", "@type": "rdfs:Class", "label": "Тип свойства"},
    {"@id": "ns:Unit", "@type": "rdfs:Class", "label": "Единица измерения"},
    {"@id": "ns:Enumeration", "@type": "rdfs:Class", "label": "Перечисление"},
    {"@id": "ns:EnumeratedValue", "@type": "rdfs:Class", "label": "Значение из перечисления"},
    {"@id": "ns:QuantitativeValue", "@type": "rdfs:Class", "label": "Количественное значение"},
    {"@id": "ns:RangeValue", "@type": "rdfs:Class", "label": "Диапазон значений"},
    {"@id": "ns:NormativeDocument", "@type": "rdfs:Class", "label": "Нормативный документ"},
    {"@id": "ns:DocumentFragment", "@type": "rdfs:Class", "label": "Фрагмент документа"},
    {"@id": "ns:DocumentConcept", "@type": "rdfs:Class", "label": "Документный концепт"},
    {"@id": "ns:Requirement", "@type": "rdfs:Class", "label": "Нормативное требование"},
    {"@id": "ns:Condition", "@type": "rdfs:Class", "label": "Условие применимости"},
    {"@id": "ns:Exception", "@type": "rdfs:Class", "label": "Исключение"},
    {"@id": "ns:NormativeForce", "@type": "rdfs:Class", "label": "Нормативная сила"},
    {"@id": "ns:Operator", "@type": "rdfs:Class", "label": "Оператор ограничения"},
    {"@id": "ns:TestMethod", "@type": "rdfs:Class", "label": "Метод проверки"},

    {"@id": "ns:definedIn", "@type": "rdf:Property", "label": "определено в", "domain": "ns:DomainEntity", "range": "ns:NormativeDocument"},
    {"@id": "ns:statedIn", "@type": "rdf:Property", "label": "содержится во фрагменте", "domain": "ns:DomainEntity", "range": "ns:DocumentFragment"},
    {"@id": "ns:denotes", "@type": "rdf:Property", "label": "обозначает", "domain": "ns:DocumentConcept", "range": "ns:DomainEntity"},
    {"@id": "ns:refersTo", "@type": "rdf:Property", "label": "соотносится с", "domain": "ns:DocumentConcept", "range": "ns:DomainEntity"},
    {"@id": "ns:appliesTo", "@type": "rdf:Property", "label": "применяется к", "domain": "ns:Requirement", "range": "ns:DomainEntity"},
    {"@id": "ns:aboutProperty", "@type": "rdf:Property", "label": "касается свойства", "domain": "ns:Requirement", "range": "ns:PropertyType"},
    {"@id": "ns:hasValue", "@type": "rdf:Property", "label": "имеет значение", "domain": "ns:Requirement"},
    {"@id": "ns:hasUnit", "@type": "rdf:Property", "label": "имеет единицу", "range": "ns:Unit"},
    {"@id": "ns:hasOperator", "@type": "rdf:Property", "label": "имеет оператор", "domain": "ns:Requirement", "range": "ns:Operator"},
    {"@id": "ns:hasCondition", "@type": "rdf:Property", "label": "имеет условие", "domain": "ns:Requirement", "range": "ns:Condition"},
    {"@id": "ns:hasNormativeForce", "@type": "rdf:Property", "label": "имеет нормативную силу", "domain": "ns:Requirement", "range": "ns:NormativeForce"},
    {"@id": "ns:verifiedBy", "@type": "rdf:Property", "label": "проверяется методом", "domain": "ns:Requirement", "range": "ns:TestMethod"},
    {"@id": "ns:relatedTo", "@type": "rdf:Property", "label": "связано с", "domain": "ns:DomainEntity", "range": "ns:DomainEntity"},
    {"@id": "ns:hasPropertyType", "@type": "rdf:Property", "label": "имеет тип свойства", "domain": "ns:DomainEntity", "range": "ns:PropertyType"},
    {"@id": "ns:hasMaterial", "@type": "rdf:Property", "label": "имеет материал", "domain": "ns:ObjectClass", "range": "ns:MaterialClass"},
    {"@id": "ns:hasEnumeration", "@type": "rdf:Property", "label": "использует перечисление", "domain": "ns:PropertyType", "range": "ns:Enumeration"},
    {"@id": "ns:specializes", "@type": "rdf:Property", "label": "уточняет", "domain": "ns:Requirement", "range": "ns:Requirement"},
    {"@id": "ns:exceptionTo", "@type": "rdf:Property", "label": "является исключением для", "domain": "ns:Requirement", "range": "ns:Requirement"},
    {"@id": "ns:conflictsWith", "@type": "rdf:Property", "label": "конфликтует с", "domain": "ns:Requirement", "range": "ns:Requirement"},
    {"@id": "ns:supersededBy", "@type": "rdf:Property", "label": "заменено", "domain": "ns:Requirement", "range": "ns:Requirement"}
  ]
}
