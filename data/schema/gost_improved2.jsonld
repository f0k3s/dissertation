    {
      "id": "gost:13579-2018",
      "type": "schema:CreativeWork",
      "title": "ГОСТ 13579-2018. Блоки бетонные для стен подвалов. Технические условия",
      "issued": "2019-05-01",
      "comment": "Стандарт распространяется на блоки из тяжелого, легкого и плотного силикатного бетона для стен подвалов и технических подполий; сплошные блоки допускается применять для фундаментов.",
      "pageStart": 3,
      "pageEnd": 14,
      "references": [
        "gost:10060-2012",
        "gost:10180-2012",
        "gost:10922-2017",
        "gost:12730.0-78",
        "gost:12730.2-78",
        "gost:12730.3-78",
        "gost:12730.5-84",
        "gost:13015-2012",
        "gost:17624-2012",
        "gost:18105-2010",
