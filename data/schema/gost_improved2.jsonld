    {
      "id": "bim:BuildingElement",
      "type": "rdfs:Class",
      "label": "Строительный элемент"
    },
    {
      "id": "bim:Block",
      "type": "rdfs:Class",
      "label": "Блок",
      "comment": "Конструктивный сборный элемент или изделие прямоугольной формы, массой от десятка килограммов до нескольких тонн, изготовляемый обычно в заводских условиях.",
      "subClassOf": "bim:BuildingElement",
      "source": "gost:13579-2018",
      "pageStart": 4,
      "pageEnd": 4
    },
    {
      "id": "bim:ConcreteBlock",
      "type": "rdfs:Class",
      "label": "Бетонный блок",
      "comment": "Блок, прочность которого в стадии эксплуатации обеспечивается одним бетоном; допускается конструктивное армирование или рабочая арматура на ограниченных участках.",
      "subClassOf": "bim:Block",
      "source": "gost:13579-2018",
      "pageStart": 4,
      "pageEnd": 4
    },
    {
      "id": "bim:BasementWallBlock",
      "type": "rdfs:Class",
      "label": "Бетонный блок для стен подвала",
      "comment": "Бетонный блок, применяемый для устройства стен подвала или технического подполья здания.",
      "subClassOf": "bim:ConcreteBlock",
      "source": "gost:13579-2018",
      "pageStart": 4,
      "pageEnd": 4,
      "hasRequirement": [
        "bim:req_geometry_tolerances",
        "bim:req_surface_quality",
        "bim:req_storage_transport"
      ]
    },

