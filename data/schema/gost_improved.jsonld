            "verificationMethod": "method:gost_26433",
            "condition": "\u0420\u0430\u0437\u043c\u0435\u0440\u044b, \u043f\u0440\u044f\u043c\u043e\u043b\u0438\u043d\u0435\u0439\u043d\u043e\u0441\u0442\u044c, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u043d\u0442\u0430\u0436\u043d\u044b\u0445 \u043f\u0435\u0442\u0435\u043b\u044c, \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0438\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0435\u0449\u0438\u043d, \u0440\u0430\u0437\u043c\u0435\u0440\u044b \u0440\u0430\u043a\u043e\u0432\u0438\u043d, \u043d\u0430\u043f\u043b\u044b\u0432\u043e\u0432 \u0438 \u043e\u043a\u043e\u043b\u043e\u0432.",
            "sourceClause": "7.6"
        },
